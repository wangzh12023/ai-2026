---
import Base from '../../layouts/Base.astro';
import ArchiveNav from '../../components/ArchiveNav.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import events from '../../events.json';
import '../../styles/article.css';
export function getStaticPaths() { return events.map((event, index) => ({ params: { slug: event.id.toLowerCase() }, props: { event, index } })); }
const { event, index } = Astro.props;
const posts = import.meta.glob('../../content/posts/*.md', { eager: true });
const post = posts[`../../content/posts/${event.id.toLowerCase()}.md`] as any;
const { Content } = post;
const headings = post.getHeadings();
const prev = events[index - 1], next = events[index + 1];
---
<Base title={`${event.title} · AI 2026`} description={event.summary} page="article-page">
<header class="site-header article-header"><a class="brand" href="/" data-home-return>AI <span>2026</span></a><div class="header-actions"><a class="github-link" href="https://github.com/wangzh12023/ai-2026" target="_blank" rel="noopener noreferrer" aria-label="GitHub 源码"><img src="/icons/siGithub.svg" alt="" width="20" height="20"/></a><button id="archive-open" aria-controls="archive-panel" aria-expanded="false">事件目录 <span aria-hidden="true">☰</span></button></div></header>
<div class="article-layout">
<aside id="archive-panel" class="archive-panel"><button id="archive-close" class="archive-close" aria-label="关闭事件目录">关闭 ×</button><ArchiveNav current={event}/></aside>
<main id="main" class="article-main">
<header class="article-title"><a class="back-link" href="/" data-home-return>← 时间线</a><time>{event.date}</time><h1>{post.frontmatter.title || event.title}</h1><p class="article-deck">{event.summary}</p></header>
<div class="inline-contents"><TableOfContents headings={headings} variant="inline"/></div>
<article id="article" class="app-prose"><Content/></article>
<nav class="post-pagination" aria-label="相邻事件">{prev ? <a href={`/posts/${prev.id.toLowerCase()}/`}><span>上一事件</span><strong>{prev.title}</strong></a> : <span/>}{next && <a href={`/posts/${next.id.toLowerCase()}/`}><span>下一事件</span><strong>{next.title}</strong></a>}</nav>
<footer class="article-footer"><a href="/" data-home-return>返回时间线</a><a href="#main" id="back-top">回到顶部 ↑</a></footer>
</main>
<aside class="article-toc"><TableOfContents headings={headings} variant="rail"/></aside>
</div>
<script>import '../../article.js';</script>
</Base>
