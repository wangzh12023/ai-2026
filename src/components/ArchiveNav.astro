---
import events from '../events.json';
const { current } = Astro.props;
const months = [...new Set(events.map(e => e.date.slice(5,7)))];
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<nav class="archive-nav" data-i18n-aria="events" aria-label="按时间浏览事件">
<div class="archive-months">{months.map(month => <details class="archive-month" open={current.date.slice(5,7) === month}>
<summary><i aria-hidden="true"></i><span data-month-text={month}>{month} 月</span></summary>
<ol>{events.filter(e => e.date.slice(5,7) === month).map(e => <li><a href={`${baseUrl}posts/${e.id.toLowerCase()}/`} aria-current={e.id === current.id ? 'page' : undefined}><time data-event-day={e.date}>{e.date.slice(8) || '上旬'}</time><span data-event-title={e.id}>{e.title}</span></a></li>)}</ol>
</details>)}</div>
</nav>
