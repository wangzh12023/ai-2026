---
import '../style.css';
const { title = '2026 · AI 纪事', description = '2026 年人工智能主事件时间线', page = 'home' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" class={page}><head><script is:inline>(()=>{try{const r=document.documentElement;r.dataset.theme=localStorage.getItem('ai-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');r.lang=localStorage.getItem('ai-language')==='en'?'en':'zh-CN';}catch{}})();</script><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="preload" href="/fonts/source-serif-4-regular.woff2" as="font" type="font/woff2" crossorigin/><meta name="theme-color" content="#ffffff"/><meta name="description" content={description}/><title>{title}</title></head><body><a href="#main" class="skip-link" data-i18n="skip">跳至正文</a><slot/><script>import "../ui.js";</script></body></html>
